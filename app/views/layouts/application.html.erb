<!DOCTYPE html>
<html>
<head>
  <title>RailsGoat</title>
  <%= stylesheet_link_tag    "application", media: "all", "data-turbolinks-track" => true %>
  <%= javascript_include_tag "application", "data-turbolinks-track" => true %>
  <%#= csrf_meta_tags %> <!-- <~ What is this for? I hear it helps w/ JS and Sea-surfing.....whatevz -->
  <!-- bootstrap css -->
<%
if cookies[:font]
  # Validate font size against allowlist of safe values
  allowed_font_sizes = ['10px', '12px', '14px', '16px', '18px', '20px', '22px', '24px', '1em', '1.1em', '1.2em', '1.3em', '1.4em', '1.5em']
  safe_font_size = allowed_font_sizes.include?(cookies[:font]) ? cookies[:font] : '16px'
%>
<style>body { font-size:<%= safe_font_size %> !important;}</style>
<%
end
%>

</head>
<body>
  <%= render "layouts/shared/header" %>
  <%= render "layouts/shared/sidebar" %>
<div class="container-fluid">
  <% if current_user %>
    <div class="dashboard-wrapper">
      <%= render "layouts/shared/messages" %>
      <%= yield %>
    </div>
  <% else %>
  <div class="login-wrapper">
    <%= render "layouts/shared/messages" %>
    <%= yield %> 
  </div>  
  <% end %>
</div>
  <%= render "layouts/shared/footer" %>

<script type="text/javascript">

//Dropdown
$('.dropdown-toggle').dropdown();
</script>

</body>
</html>
